# QuickBite Backend Configuration

# Port for the Express server to listen on (automatically set by Render)
PORT=3001

# Run mode: development or production
NODE_ENV=development

# Secret key used for JWT signing and verification (ensure this is a long random string in production)
JWT_SECRET=quickbite-super-secret-key-college-cafeteria

# Allowed CORS Origin (comma-separated list, or * to allow all origins)
CORS_ORIGIN=*

# Public URL of the backend (used in robots.txt sitemap reference)
BACKEND_URL=http://localhost:3001

# Public URL of the frontend (used for sitemap absolute link generation)
FRONTEND_URL=http://localhost:5173
